<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="using:Grocery.App.ViewModels"
             x:Class="Grocery.App.Views.NewProductView"
             x:DataType="vm:NewProductViewModel">
    <ContentPage.Content>
        <StackLayout Padding="5">
            <Label Text="Nieuwe product toevoegen" FontSize="24" HorizontalOptions="Center" />
            <Entry Placeholder="Product naam" Text="{Binding Name}" />
            <Entry Placeholder="Product aantal" Text="{Binding Stock}"  />
            <DatePicker Date="{Binding ShelfLifeDateTime, Mode=TwoWay}" />
            <Entry Placeholder="Product prijs"
                   Text="{Binding Price, Mode=TwoWay, StringFormat='{}{0:F2}'}" />
            <Button 
                Text="Product toevoegen" 
                Command="{Binding CreateProductCommand}"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>